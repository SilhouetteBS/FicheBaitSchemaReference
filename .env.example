# Optional Sentry pilot. Disabled unless explicitly enabled; do not add secrets to VITE_*.
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=staging
# Use the exact source commit/build ID, not package.json's placeholder version.
VITE_SENTRY_RELEASE=
# Build-only values: configure through the release runner/secret store.
SENTRY_UPLOAD_SOURCEMAPS=false
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN must be supplied securely to the build environment.
